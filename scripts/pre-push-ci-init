#!/usr/bin/env bash
set -euo pipefail

# 予期しないエラーで通常の git push 全体を止めないためのフェイルセーフ
trap 'exit 0' ERR

# =============================================================================
# グローバル pre-push フック本体（~/.local/share/gh-wrapper/pre-push-ci-init）
#
# `~/.git-templates/hooks/pre-push` のスタブから exec で呼ばれる本体スクリプト．
# Web 版 GitHub で空リポを作って初回 git push した際の `.github/workflows/ci.yml`
# 入れ忘れを防ぐ．
#
# 制御方法:
#   - 事前スキップ（1回だけ）: GH_SKIP_CI_INIT=1 git push
#   - リポ単位で無効化:        git config hooks.skipCiInit true
#   - 対象オーナー設定:        git config --global hooks.ciOwner <your-github-username>
# =============================================================================

REMOTE_NAME="${1:-}"
REMOTE_URL="${2:-}"

if [ "${GH_SKIP_CI_INIT:-}" = "1" ] || [ "${GH_SKIP_CI_INIT:-}" = "true" ]; then
  exit 0
fi

if [ "$(git config --bool --get hooks.skipCiInit 2>/dev/null || echo false)" = "true" ]; then
  exit 0
fi

OWNER="${GH_CI_OWNER:-$(git config --get hooks.ciOwner 2>/dev/null || true)}"
if [ -z "$OWNER" ] || [ -z "$REMOTE_URL" ]; then
  exit 0
fi

REMOTE_URL_LOWER="$(printf '%s' "$REMOTE_URL" | tr '[:upper:]' '[:lower:]')"
OWNER_LOWER="$(printf '%s' "$OWNER" | tr '[:upper:]' '[:lower:]')"

OWNER_REGEX="$(printf '%s' "$OWNER_LOWER" | sed 's/[][\\.^$*+?(){}|]/\\&/g')"
if ! printf '%s' "$REMOTE_URL_LOWER" | grep -Eq "^(https://([^@/]+@)?github\.com/|(ssh://)?git@github(\.com|-[a-z0-9._-]+)[:/])${OWNER_REGEX}/"; then
  exit 0
fi

CURRENT_BRANCH="$(git symbolic-ref -q HEAD 2>/dev/null || true)"
if [ -z "$CURRENT_BRANCH" ]; then
  exit 0
fi
HEAD_SHA="$(git rev-parse -q --verify HEAD 2>/dev/null || true)"
if [ -z "$HEAD_SHA" ]; then
  exit 0
fi

pushing_new_head_branch=false
remote_already_has_refs=false

while IFS=' ' read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "${local_ref:-}" ] && continue
  if [ -n "${remote_sha:-}" ] && ! printf '%s' "$remote_sha" | grep -Eq '^0+$'; then
    remote_already_has_refs=true
  fi
  if printf '%s' "${local_sha:-}" | grep -Eq '^0+$'; then
    continue
  fi
  if [ "$local_sha" = "$HEAD_SHA" ]; then
    case "${remote_ref:-}" in
      refs/heads/*)
        pushing_new_head_branch=true
        ;;
    esac
  fi
done

if [ "$remote_already_has_refs" = true ] || [ "$pushing_new_head_branch" != true ]; then
  exit 0
fi

if git cat-file -e "${HEAD_SHA}:.github/workflows" 2>/dev/null; then
  exit 0
fi

REMOTE_TARGET="${REMOTE_NAME:-$REMOTE_URL}"
if ! remote_heads="$(git ls-remote --heads "$REMOTE_TARGET" 2>/dev/null)"; then
  exit 0
fi
if [ -n "$remote_heads" ]; then
  exit 0
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  exit 0
fi

CI_INIT="$HOME/.local/share/gh-wrapper/ci-init"
if [ ! -x "$CI_INIT" ]; then
  echo "[pre-push] Warning: $CI_INIT not found or not executable. Skipping." >&2
  exit 0
fi

echo "[pre-push] 空リポジトリへの初回 push で .github/workflows が未コミットのため，デフォルト CI を追加します..." >&2
status_file="$(mktemp -t gh-prepush-status.XXXXXX)"
trap 'rm -f "${status_file:-}"' EXIT

if "$CI_INIT" "$REPO_ROOT" --commit-mode require --allow-existing-dir --status-file "$status_file"; then
  ci_status="$(cat "$status_file" 2>/dev/null || true)"
  rm -f "$status_file"
  if [ "$ci_status" = "committed" ]; then
    trap - ERR
    cat >&2 << 'EOF'

[pre-push] .github/workflows/ci.yml 等を生成して単独コミットしました．
[pre-push] Git の仕様上，進行中の push には新しいコミットが含まれないため一度中断します．
[pre-push] 以下のコマンドを実行すると，CI を含めてプッシュされます:
           - git push を実行した場合: 同じ git push コマンドを再実行
           - gh repo create 経由の場合: git push -u origin HEAD
           （自動コミットを取り消す場合: git reset HEAD~1）
           （このリポで無効化する場合: git config hooks.skipCiInit true）
EOF
    exit 1
  fi
  # skipped 等の場合はそのまま push を続行する
  exit 0
else
  ci_status="$(cat "$status_file" 2>/dev/null || true)"
  rm -f "$status_file"
  if [ "$ci_status" = "skipped" ]; then
    echo "[pre-push] Warning: CI 初期化がスキップされたため（テンプレート欠落等），そのまま push を続行します．" >&2
    exit 0
  fi
  trap - ERR
  cat >&2 << 'EOF'

[pre-push] .github/workflows/ci.yml 等の自動コミットに失敗しました．
[pre-push] 状態を確認して手動コミット後に再度 git push してください．
           （今回だけスキップしてそのまま push する場合: GH_SKIP_CI_INIT=1 git push）
EOF
  exit 1
fi
