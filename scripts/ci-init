#!/usr/bin/env bash
set -euo pipefail

# =============================================================================
# 共通 CI & リポジトリ初期設定スクリプト（~/.local/share/gh-wrapper/ci-init）
#
# `gh` ラッパーおよび `pre-push` フックの双方から呼び出され，対象リポジトリの
# ルートへ未作成の標準設定ファイル群を配置し，必要に応じて単独コミットする．
#
# 配置対象（まだ存在しないファイルのみ作成し，既存ファイルや symlink は上書きしない）:
#   - .github/workflows/ci.yml
#   - .github/dependabot.yml
#   - .editorconfig
#   - .gitattributes
#
# 環境変数:
#   GH_CI_TEMPLATE=/path/to.yml  : ci.yml テンプレートの上書き
#   GH_CI_MINIMAL=1              : ci.yml のみ生成（dependabot/editorconfig/gitattributes 省略）
# =============================================================================

usage() {
  echo "Usage: ci-init <target_dir> [--commit-mode auto|require] [--allow-existing-dir] [--status-file <path>]" >&2
}

if [ "$#" -lt 1 ]; then
  usage
  exit 2
fi

TARGET_ARG="$1"
shift

COMMIT_MODE="auto"
ALLOW_EXISTING_DIR=false
STATUS_FILE=""

while [ "$#" -gt 0 ]; do
  case "$1" in
    --commit-mode)
      if [ "$#" -lt 2 ]; then
        echo "[ci-init] Error: --commit-mode requires a value (auto|require)." >&2
        exit 2
      fi
      COMMIT_MODE="$2"
      shift 2
      ;;
    --allow-existing-dir)
      ALLOW_EXISTING_DIR=true
      shift
      ;;
    --status-file)
      if [ "$#" -lt 2 ]; then
        echo "[ci-init] Error: --status-file requires a path." >&2
        exit 2
      fi
      STATUS_FILE="$2"
      shift 2
      ;;
    *)
      echo "[ci-init] Unknown option: $1" >&2
      exit 2
      ;;
  esac
done

case "$COMMIT_MODE" in
  auto|require) ;;
  *)
    echo "[ci-init] Error: Invalid --commit-mode '$COMMIT_MODE' (expected auto or require)." >&2
    exit 2
    ;;
esac

write_status() {
  if [ -n "$STATUS_FILE" ]; then
    printf '%s\n' "$1" > "$STATUS_FILE"
  fi
}

if [ ! -d "$TARGET_ARG" ]; then
  echo "[ci-init] Warning: Directory not found: $TARGET_ARG" >&2
  write_status "skipped"
  exit 1
fi

TARGET_DIR="$(CDPATH= cd "$TARGET_ARG" && pwd -P)"

if [ "$(git -C "$TARGET_DIR" rev-parse --is-inside-work-tree 2>/dev/null || echo false)" != "true" ]; then
  echo "[ci-init] Warning: Not a git working tree: $TARGET_DIR" >&2
  write_status "skipped"
  exit 1
fi

REPO_PREFIX="$(git -C "$TARGET_DIR" rev-parse --show-prefix 2>/dev/null)"
if [ -n "$REPO_PREFIX" ]; then
  echo "[ci-init] Warning: '$TARGET_DIR' is not the repository root (prefix: '$REPO_PREFIX'). Skipping CI initialization." >&2
  write_status "skipped"
  exit 0
fi

REPO_ROOT="$(git -C "$TARGET_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
if [ -z "$REPO_ROOT" ]; then
  echo "[ci-init] Warning: Could not resolve git repository root for: $TARGET_DIR" >&2
  write_status "skipped"
  exit 1
fi

SHARE_DIR="$HOME/.local/share/gh-wrapper"
TEMPLATE_FILE="${GH_CI_TEMPLATE:-$SHARE_DIR/ci.yml}"
if [ ! -f "$TEMPLATE_FILE" ]; then
  echo "[ci-init] Warning: Template not found at $TEMPLATE_FILE. Skipping." >&2
  write_status "skipped"
  exit 1
fi

WORKFLOW_DIR="$REPO_ROOT/.github/workflows"
CI_REL_FILE=".github/workflows/ci.yml"
CI_FILE="$REPO_ROOT/$CI_REL_FILE"

if [ -d "$WORKFLOW_DIR" ] && [ "$ALLOW_EXISTING_DIR" != true ]; then
  echo "[ci-init] $WORKFLOW_DIR already exists. Skipping." >&2
  write_status "skipped"
  exit 0
fi

files_to_commit=()

# 1. .github/workflows/ci.yml（壊れた symlink への書き込みを防ぐため -e と -L の両方をチェック）
if [ ! -e "$CI_FILE" ] && [ ! -L "$CI_FILE" ]; then
  echo "[ci-init] Initializing default CI workflow at $CI_FILE..." >&2
  mkdir -p "$WORKFLOW_DIR"
  cp "$TEMPLATE_FILE" "$CI_FILE"
  files_to_commit+=("$CI_REL_FILE")
elif [ -f "$CI_FILE" ]; then
  echo "[ci-init] Found existing $CI_FILE in working tree; reusing it." >&2
  if git -C "$REPO_ROOT" rev-parse --verify HEAD >/dev/null 2>&1; then
    if ! git -C "$REPO_ROOT" cat-file -e "HEAD:$CI_REL_FILE" 2>/dev/null; then
      files_to_commit+=("$CI_REL_FILE")
    fi
  fi
fi

# 2. 追加の標準設定（dependabot.yml / .editorconfig / .gitattributes）
if [ "${GH_CI_MINIMAL:-}" != "1" ] && [ "${GH_CI_MINIMAL:-}" != "true" ]; then
  DEP_REL=".github/dependabot.yml"
  DEP_FILE="$REPO_ROOT/$DEP_REL"
  DEP_GEN="$SHARE_DIR/generate_dependabot.py"
  if [ ! -e "$DEP_FILE" ] && [ ! -L "$DEP_FILE" ] && [ -f "$DEP_GEN" ]; then
    mkdir -p "$REPO_ROOT/.github"
    if python3 "$DEP_GEN" "$REPO_ROOT" > "$DEP_FILE"; then
      echo "[ci-init] Generated $DEP_REL." >&2
      files_to_commit+=("$DEP_REL")
    else
      rm -f "$DEP_FILE"
    fi
  fi

  EC_REL=".editorconfig"
  EC_FILE="$REPO_ROOT/$EC_REL"
  EC_TMPL="$SHARE_DIR/editorconfig"
  if [ ! -e "$EC_FILE" ] && [ ! -L "$EC_FILE" ] && [ -f "$EC_TMPL" ]; then
    cp "$EC_TMPL" "$EC_FILE"
    echo "[ci-init] Generated $EC_REL." >&2
    files_to_commit+=("$EC_REL")
  fi

  GA_REL=".gitattributes"
  GA_FILE="$REPO_ROOT/$GA_REL"
  GA_TMPL="$SHARE_DIR/gitattributes"
  if [ ! -e "$GA_FILE" ] && [ ! -L "$GA_FILE" ] && [ -f "$GA_TMPL" ]; then
    # 既存リポに CRLF ファイルが含まれる場合，eol=lf 強制による偽差分を防ぐためスキップする
    if git -C "$REPO_ROOT" ls-files --eol 2>/dev/null | grep -q 'i/crlf'; then
      echo "[ci-init] Warning: Existing CRLF-tracked files detected; skipping $GA_REL to avoid spurious line-ending diffs." >&2
    else
      cp "$GA_TMPL" "$GA_FILE"
      echo "[ci-init] Generated $GA_REL." >&2
      files_to_commit+=("$GA_REL")
    fi
  fi
fi

if [ "${#files_to_commit[@]}" -eq 0 ]; then
  write_status "skipped"
  exit 0
fi

if git -C "$REPO_ROOT" rev-parse --verify HEAD >/dev/null 2>&1; then
  echo "[ci-init] Committing initialized files (${files_to_commit[*]})..." >&2
  if ! git -C "$REPO_ROOT" add -- "${files_to_commit[@]}" >&2; then
    echo "[ci-init] Warning: Failed to stage files (e.g. ignored by .gitignore)." >&2
    write_status "created"
    if [ "$COMMIT_MODE" = "require" ]; then
      exit 1
    fi
    exit 0
  fi

  # --no-verify で他ツールの commit-msg / pre-commit フックとの衝突を防ぎつつ，対象ファイルだけを単独コミット
  if CI_CHECK_SKIP=1 git -C "$REPO_ROOT" commit --no-verify -m "初期設定: 汎用 CI ワークフローと基本設定ファイルを追加" -- "${files_to_commit[@]}" >&2; then
    write_status "committed"
    exit 0
  else
    echo "[ci-init] Warning: Failed to commit initialized files." >&2
    write_status "created"
    if [ "$COMMIT_MODE" = "require" ]; then
      exit 1
    fi
    exit 0
  fi
else
  echo "[ci-init] Initial repository without commits detected. Leaving generated files for initial commit." >&2
  write_status "created"
  if [ "$COMMIT_MODE" = "require" ]; then
    exit 1
  fi
  exit 0
fi
